# RockPro64 additions on top of tinker_board_2_defconfig
# (PRODUCT_KERNEL_CONFIG := tinker_board_2_defconfig rockpro64.config)

# The ASUS fan53555 change behind this option swaps the VSEL0/VSEL1 roles for
# fcs,suspend-voltage-selector = <1>. On RockPro64 VSEL0 is the run-time
# register (VSEL pin low), so the "suspend disable" applied at registration
# clears BUCK_EN of the running vdd_cpu_b/vdd_gpu and the board hangs right
# after "FAN53555 Option[8] Rev[1] Detected!".
# CONFIG_REGULATOR_TINKER is not set

# Intel I350 (8086:1521) and other igb-family PCIe NICs in the x4 slot.
# Built in: Android does not load modules from vendor_dlkm for this board.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IGB=y
CONFIG_IGB_HWMON=y
