/*
 * Pine64 RockPro64 (v2.1) for the TinkerBoard-Android Android 12 SDK
 * (kernel 4.19, tinker_board_2-android12-3.0.10).
 *
 * Board hardware comes from rk3399-rockpro64.dts; this file only adds what
 * the Rockchip Android userspace expects (rk3399-android.dtsi: fiq-debugger
 * console, drm-logo/ramoops, firmware/android, VOPL, MPP, IEP, RGA ...) and
 * the Rockchip-style (rfkill/bcmdhd) WiFi/BT description.
 *
 * Nothing here is taken from rk3399-tinker-board-2.dtsi's PMIC/OPP sections:
 * that board leaves vdd_cpu_b/vdd_gpu unmanaged and adds 1.512/2.016 GHz OPPs.
 */

#include "rk3399-rockpro64.dts"
#include "rk3399-android.dtsi"

/ {
	model = "Pine64 RockPro64 (Android)";
	compatible = "pine64,rockpro64-v2.1", "pine64,rockpro64",
		     "rockchip,android", "rockchip,rk3399";

	chosen: chosen {
		/* same command line as rk3399-tinker-board-2.dts */
		bootargs = "earlycon=uart8250,mmio32,0xff1a0000 console=ttyFIQ0 androidboot.baseband=N/A androidboot.veritymode=enforcing androidboot.hardware=rk30board androidboot.console=ttyFIQ0 init=/init initrd=0x62000001,0x00800000 coherent_pool=1m";
		/delete-property/ stdout-path;
	};

	/*
	 * ASUS drivers/boardinfo: stmmac/dwmac-rk call get_board_model(), which
	 * strcmp()s the "model" string read from this node (NULL without it ->
	 * Oops in stmmac_probe_config_dt). A model other than rk3288/rk3399/
	 * rk3568/rk3566 makes get_board_model() return -1: no Tinker hw-id GPIO
	 * probing and no Tinker-specific RGMII delay/WOL overrides (the DTS
	 * tx_delay/rx_delay are used).
	 */
	board-info {
		compatible = "board-info";
		model = "rockpro64";
		board = "rockpro64";
	};

	/*
	 * RockPro64 "Recover" button on SARADC_IN1 (pulled up to 1.8 V, pressed =
	 * 0 V), as in mainline rk3399-rockpro64.dtsi.
	 *
	 * Rockchip U-Boot uses KEY_VOLUMEUP as its recovery/download key and looks
	 * for it in the kernel DTB first. When the kernel DTB has none, it falls
	 * back to its own rk3399-evb DT keys (rk_key0: SARADC ch1, rk_key1: SARADC
	 * ch2 for RK3399PRO EVB), whose ADC level reads as "pressed" on RockPro64:
	 * "download key pressed... entering recovery mode!" on every boot.
	 * Mapping the Recover button to KEY_VOLUMEUP gives U-Boot a real key.
	 * (The kernel does not use this node: CONFIG_KEYBOARD_ADC is off.)
	 */
	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		recovery-key {
			label = "Recovery";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <18000>;
		};
	};

	/*
	 * Optional PINE64 WiFi/BT module (AzureWave AW-CM256SM, BCM4345 rev 6).
	 * bcmdhd recognised it with the AP6255 firmware in the Yocto bring-up.
	 * Pin assignment as in mainline rk3399-rockpro64.dtsi:
	 *   WL_REG_ON  GPIO0_B2 (sdio_pwrseq reset-gpios)
	 *   WL_HOST_WAKE GPIO0_A3 (not described in mainline - verify)
	 *   BT_REG_ON  GPIO0_B1, BT_HOST_WAKE GPIO0_A4, BT_WAKE GPIO2_D3
	 *   UART0 RTS  GPIO2_C3 (uart0_gpios, already in rk3399-rockpro64.dts)
	 */
	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "ap6255";
		sdio_vref = <1800>;
		WIFI,host_wake_irq = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <&rk808 1>;
		clock-names = "ext_clock";
		uart_rts_gpios = <&gpio2 RK_PC3 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart0_rts>;
		pinctrl-1 = <&uart0_gpios>;
		BT,reset_gpio    = <&gpio0 RK_PB1 GPIO_ACTIVE_HIGH>;
		BT,wake_gpio     = <&gpio2 RK_PD3 GPIO_ACTIVE_HIGH>;
		BT,wake_host_irq = <&gpio0 RK_PA4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

/*
 * UART2 belongs to the fiq-debugger (ttyFIQ0). 115200 to match the U-Boot
 * built from tinker_board_2_defconfig (CONFIG_BAUDRATE=115200).
 * The baud clock is parented to xin24m: the reset default
 * (clk_uart2_div <- clk_uart_src <- CPLL) garbled the console early in boot
 * on the FriendlyELEC 4.19 bring-up.
 */
&fiq_debugger {
	rockchip,baudrate = <115200>;
	assigned-clocks = <&cru SCLK_UART2>;
	assigned-clock-parents = <&xin24m>;
};

/* gpio-keys from rk3399-android.dtsi owns the power key (GPIO0_A5) */
&rk_key {
	status = "disabled";
};

/* rk3399-android.dtsi disables these; RockPro64 has HDMI on VOPB */
&route_hdmi {
	status = "okay";
};

/*
 * "rockchip,rk3399-hdmi-dp" (4.4 machine driver) is not built in this
 * 4.19 kernel, so this card never registers (only the ES8316 card shows in
 * the ALSA list). Use the simple-audio-card HDMI card from rk3399.dtsi
 * (i2s2 <-> dw-hdmi), as the Tinker Board 2 does.
 */
&hdmi_dp_sound {
	status = "disabled";
};

&hdmi_sound {
	status = "okay";
};

/* Bluetooth UART (RTS is handled by wireless-bluetooth) */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_xfer &uart0_cts>;
	status = "okay";
};
